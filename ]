#include "QuantXCore/data/MarketTick.hpp"

#include <charconv>
#include <system_error>
#include <type_traits>
#include <nlohmann/json.hpp>

namespace QuantXCore::data {

// Helper: Fast double parsing from string_view using charconv (zero-allocation)
[[nodiscard]] static std::optional<double> parse_double(std::string_view sv) noexcept {
    double value = 0.0;
    const char* begin = sv.data();
    const char* end = sv.data() + sv.size();
    const auto [ptr, ec] = std::from_chars(begin, end, value);
    
    if (ec == std::errc() && ptr == end) {
        return value;
    }
    return std::nullopt;
}

// Helper: Fast uint64_t parsing from string_view using charconv (zero-allocation)
[[nodiscard]] static std::optional<uint64_t> parse_uint64(std::string_view sv) noexcept {
    uint64_t value = 0;
    const char* begin = sv.data();
    const char* end = sv.data() + sv.size();
    const auto [ptr, ec] = std::from_chars(begin, end, value);
    
    if (ec == std::errc() && ptr == end) {
        return value;
    }
    return std::nullopt;
}

// Helper: Fast bool parsing from string_view (for "is_buyer_maker")
[[nodiscard]] static std::optional<bool> parse_bool(std::string_view sv) noexcept {
    if (sv == "true" || sv == "1") {
        return true;
    }
    if (sv == "false" || sv == "0") {
        return false;
    }
    return std::nullopt;
}

[[nodiscard]] std::optional<MarketTick> parse_binance_tick(std::string_view raw_json) noexcept {
    try {
        // Parse JSON without extra allocations (uses string_views)
        const json j = json::parse(raw_json, nullptr, false);
        
        // Check for parse errors (malformed JSON)
        if (j.is_discarded()) {
            return std::nullopt;
        }

        // Validate required fields exist and are strings
        if (!j.contains("p") || !j["p"].is_string() ||
            !j.contains("q") || !j["q"].is_string() ||
            !j.contains("T") || !j["T"].is_number() ||
            !j.contains("m") || !j["m"].is_boolean()) {
            return std::nullopt;
        }

        MarketTick tick{};

        // Parse price (string to double)
        const std::string& price_str = j["p"].get_ref<const std::string&>();
        auto price_opt = parse_double(price_str);
        if (!price_opt.has_value()) {
            return std::nullopt;
        }
        tick.price = price_opt.value();

        // Parse quantity (string to double)
        const std::string& qty_str = j["q"].get_ref<const std::string&>();
        auto qty_opt = parse_double(qty_str);
        if (!qty_opt.has_value()) {
            return std::nullopt;
        }
        tick.quantity = qty_opt.value();

        // Parse timestamp (uint64_t)
        if (j["T"].is_number_integer() || j["T"].is_number_unsigned()) {
            tick.timestamp = j["T"].get<uint64_t>();
        } else {
            return std::nullopt;
        }

        // Parse buyer maker flag (boolean)
        tick.is_buyer_maker = j["m"].get<bool>();

        // Parse optional fields if present
        if (j.contains("a") && j["a"].is_number()) {
            tick.trade_id = j["a"].get<uint64_t>();
        }

        if (j.contains("s") && j["s"].is_string()) {
            const std::string& symbol = j["s"].get_ref<const std::string&>();
            // Store string_view pointing to the JSON parser's internal storage
            // Note: This is safe because the JSON object 'j' lives until the function returns
            // However, we need to ensure the data persists. For production, we'd
            // want to store this more carefully, but this matches our zero-copy design.
            tick.symbol = std::string_view(symbol.data(), symbol.size());
        }

        return tick;
    } catch (...) {
        // Any exception means malformed data
        return std::nullopt;
    }
}

} // namespace QuantXCore::data
